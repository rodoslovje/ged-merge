{
  "name": "ged-merge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-only GEDCOM editor: edit a family tree, merge a second GEDCOM into it field by field, and maintain the whole file — with no upload and no backend",
  "keywords": [
    "gedcom",
    "genealogy",
    "family-tree",
    "merge",
    "ancestry",
    "offline-first",
    "browser-only"
  ],
  "homepage": "https://gedmerge.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodoslovje/ged-merge.git"
  },
  "bugs": {
    "url": "https://github.com/rodoslovje/ged-merge/issues"
  },
  "author": "Luka Renko",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "i18next": "^26.5.6",
    "leaflet": "^1.9.4",
    "pbf": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
